# ============================================================================
# GeoLogística — Variables de entorno de ejemplo
# Copia este archivo como ".env" y reemplaza los valores por los reales.
# NUNCA subas el archivo ".env" real a GitHub.
# ============================================================================

# --- Google Maps Platform -----------------------------------------------
# Clave de navegador (pública, pero DEBE restringirse por dominio/HTTP referrer
# y por API en Google Cloud Console). Habilita: Maps JavaScript API, Places API.
VITE_GOOGLE_MAPS_BROWSER_KEY=REEMPLAZA_CON_TU_CLAVE_DE_NAVEGADOR

# ID de mapa (opcional, para estilos de Cloud-based Map Styling)
VITE_GOOGLE_MAPS_MAP_ID=

# --- Supabase (proyecto) --------------------------------------------------
# URL del proyecto y clave "anon" pública. La clave "anon" es segura de exponer
# en el frontend SIEMPRE que las políticas de RLS estén correctamente configuradas
# (ver supabase/policies.sql). NUNCA expongas la "service_role key" en el frontend.
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=REEMPLAZA_CON_TU_CLAVE_ANON

# --- Backend / funciones serverless (privadas, NO usar prefijo VITE_) ----
# Clave de servidor de Google Maps Platform, restringida por IP, usada solo por
# la función de resolución de enlaces (supabase/functions/resolve-link).
# Habilita: Geocoding API, Routes API.
GOOGLE_MAPS_SERVER_KEY=REEMPLAZA_CON_TU_CLAVE_DE_SERVIDOR

# Clave "service_role" de Supabase, usada solo dentro de Edge Functions
# (nunca en el frontend).
SUPABASE_SERVICE_ROLE_KEY=REEMPLAZA_CON_TU_SERVICE_ROLE_KEY
